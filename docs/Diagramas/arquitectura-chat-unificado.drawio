<mxfile host="drawio"><diagram id="arq" name="Arquitectura"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Objetivo:&lt;/b&gt; unificar el chat y los eventos de Twitch y Kick en un único modelo (ChatEvent) y exponerlo a cualquier cliente vía gRPC" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1660" height="50" as="geometry"/></mxCell><mxCell id="L0" value="Fuentes externas" style="swimlane;html=1;startSize=40;rounded=1;fontStyle=1;fontSize=14;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="200" height="560" as="geometry"/></mxCell><mxCell id="L1" value="Capa 1 · Ingesta (adaptadores)" style="swimlane;html=1;startSize=40;rounded=1;fontStyle=1;fontSize=14;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="290" y="100" width="240" height="560" as="geometry"/></mxCell><mxCell id="L2" value="Capa 2 · Normalización" style="swimlane;html=1;startSize=40;rounded=1;fontStyle=1;fontSize=14;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="580" y="100" width="240" height="560" as="geometry"/></mxCell><mxCell id="L3" value="Capa 3 · Núcleo" style="swimlane;html=1;startSize=40;rounded=1;fontStyle=1;fontSize=14;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="870" y="100" width="240" height="560" as="geometry"/></mxCell><mxCell id="L4" value="Capa 4 · Exposición gRPC" style="swimlane;html=1;startSize=40;rounded=1;fontStyle=1;fontSize=14;whiteSpace=wrap;fillColor=#ffe6c